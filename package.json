{
  "name": "@rainpulse/flashmath",
  "version": "0.0.0",
  "private": true,
  "description": "TeX to MathML parser for React, conformance-tested against MathJax",
  "type": "module",
  "license": "MIT",
  "author": "minamorl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rainpulse/flashmath-ts.git"
  },
  "devDependencies": {
    "@mathjax/src": "4.1.3",
    "temml": "0.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs test/packages/*.test.mjs",
    "conformance": "node bench/flashmath/conformance.mjs",
    "bench": "node bench/flashmath/run.mjs"
  }
}
